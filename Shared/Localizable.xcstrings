        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PDF está dañado, vacío o no se puede leer."
          }
        }
      }
    },
    "issue.protectedPDF": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请换未加密、允许复制的 PDF。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an unencrypted PDF that allows copying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請改選未加密、允許複製的 PDF。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されていない、コピー可能な PDF を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되지 않고 복사가 허용된 PDF를 고르세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein unverschlüsseltes PDF, das Kopieren erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un PDF sin cifrar que permita copiar."
          }
        }
      }
    },
    "issue.interactivePDF": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能丢失签名或表单，仍要合并？原文件会保留。"
