        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能遺失簽名或表單，仍要合併？原檔案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名やフォーム項目が失われる可能性があります。続けますか？元のファイルは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명이나 양식 필드가 사라질 수 있습니다. 계속할까요? 원본은 그대로 남습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen oder Formularfelder können verloren gehen. Fortfahren? Originale bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las firmas o campos de formulario podrían perderse. ¿Continuar? Los originales se conservan."
          }
        }
      }
    },
