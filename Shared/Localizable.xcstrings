    "purchase.detail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理多套模板、应用命名规则、批量生成 PDF，也可把 PDF 页面存到相册。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage templates, apply naming rules, create PDFs in batches and save PDF pages to Photos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理多套範本、套用命名規則、批次產生 PDF，也可將 PDF 頁面儲存到相簿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートの管理、命名ルールの適用、PDF の一括作成、PDF ページの写真アプリへの保存ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿 관리, 이름 규칙, PDF 일괄 만들기, PDF 페이지를 사진에 저장할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen verwalten, Benennungsregeln anwenden, PDFs im Stapel erstellen und PDF-Seiten in Fotos sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona plantillas, aplica reglas de nombre, crea PDF por lotes y guarda páginas de PDF en Fotos."
          }
        }
      }
    },
    "purchase.free": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并、排页、旋转、移除和无水印导出一直免费。原文件和旧记录不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge, reorder, rotate, remove and export without watermarks for free. Originals and past results stay available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併、排序、旋轉、移除與無浮水印匯出一直免費。原檔和舊記錄不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結合、並べ替え、回転、削除、透かしなしの書き出しは無料です。元のファイルと過去の結果は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합, 순서 변경, 회전, 빼기, 워터마크 없는 내보내기는 무료입니다. 원본과 지난 결과도 계속 쓸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfügen, sortieren, drehen, entfernen und ohne Wasserzeichen exportieren – gratis. Originale und frühere Ergebnisse bleiben verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une, reordena, gira, quita y exporta sin marca de agua gratis. Los originales y resultados anteriores siguen disponibles."
          }
        }
      }
    },
    "purchase.owned": {
