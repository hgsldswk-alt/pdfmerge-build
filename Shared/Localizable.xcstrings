    "settings.cleanupDetail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可清理 %@（未使用的输入副本和未完成的输出）。保留草稿、模板、最近生成和外部文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can be removed (unused input copies and incomplete outputs). Drafts, templates, recent PDFs and external files are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可清理 %@（未使用的輸入副本及未完成的輸出）。會保留草稿、範本、最近產生及外部檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除できます（使っていない入力のコピーと未完成の出力）。下書き、テンプレート、最近のPDF、外部のファイルは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 지울 수 있습니다 (쓰지 않는 입력 사본과 미완성 결과). 임시 저장, 템플릿, 최근 PDF, 외부 파일은 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ können entfernt werden (ungenutzte Eingabekopien und unvollständige Ergebnisse). Entwürfe, Vorlagen, letzte PDFs und externe Dateien bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden quitar %@ (copias de entrada sin usar y resultados incompletos). Se conservan borradores, plantillas, PDF recientes y archivos externos."
          }
        }
      }
    },
