    "home.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次选多份，排好页面，离线生成新 PDF。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files, arrange pages and create a new PDF offline."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次選多份，排好頁面，離線產生新 PDF。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを選び、ページを並べて、オフラインで新しいPDFを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 고르고 페이지를 정리해 오프라인으로 새 PDF를 만드세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien wählen, Seiten anordnen und offline ein neues PDF erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige archivos, ordena las páginas y crea un PDF nuevo sin conexión."
          }
        }
      }
    },
