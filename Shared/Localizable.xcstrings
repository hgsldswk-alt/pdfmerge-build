    "card.importHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只分享通用顺序，不含 PDF 或文件名。收件人可导入模板后选自己的文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only generic order is shared, not PDFs or file names. Recipients can import the template and choose their own files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只分享通用順序，不含 PDF 或檔名。收件人可匯入範本後選擇自己的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されるのは一般的な順番だけで、PDFやファイル名は含まれません。受け取った人はテンプレートを取り込んで自分のファイルを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF나 파일 이름이 아닌 일반 순서만 공유됩니다. 받은 사람은 템플릿을 가져와 자기 파일을 고를 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilt wird nur die allgemeine Reihenfolge, keine PDFs oder Dateinamen. Empfänger können die Vorlage importieren und eigene Dateien wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comparte un orden genérico, no los PDF ni los nombres de archivo. Quien lo reciba puede importar la plantilla y elegir sus propios archivos."
          }
        }
      }
    },
