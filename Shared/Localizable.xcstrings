    "settings.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 和模板只在本机处理，无账号、广告、统计或自建服务器。文件 App 按你的选择从文件提供方取件；分享目标由你选择。购买和恢复由 App Store 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFs and templates are processed on device. No account, ads, analytics or developer servers. Files retrieves documents from the provider you select. You choose where to share. The App Store processes purchases and restores."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 和範本只在本機處理，沒有帳號、廣告、統計或自建伺服器。「檔案」依你的選擇從提供者取得檔案；分享位置由你選擇。購買和回復由 App Store 處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFとテンプレートは端末上で処理されます。アカウント、広告、分析ツール、開発者のサーバーはありません。「ファイル」は選んだ提供元から書類を取得します。共有先はあなたが選びます。購入と復元はApp Storeが処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF와 템플릿은 기기에서 처리됩니다. 계정, 광고, 분석, 개발자 서버가 없습니다. 파일 앱은 직접 고른 제공자에서 문서를 가져옵니다. 공유할 곳은 직접 고릅니다. 구매와 복원은 App Store가 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFs und Vorlagen werden auf dem Gerät verarbeitet. Kein Konto, keine Werbung, keine Analyse, keine Entwickler-Server. Dateien lädt Dokumente vom gewählten Anbieter. Du bestimmst, wohin geteilt wird. Käufe und Wiederherstellung laufen über den App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los PDF y las plantillas se procesan en el dispositivo. Sin cuenta, anuncios, analíticas ni servidores del desarrollador. Archivos obtiene los documentos del proveedor que elijas. Tú decides dónde compartir. El App Store gestiona compras y restauraciones."
          }
        }
      }
    },
