    "issue.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件。请下载到本机或重选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read this file. Download it locally or choose again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取檔案。請下載到本機或重新選擇。"
          }
        }
      }
    },
    "issue.invalidPDF": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 已损坏、没有页面或无法读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF is damaged, empty or unreadable."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 已損毀、沒有頁面或無法讀取。"
          }
        }
      }
    },
    "issue.protectedPDF": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请换未加密、允许复制的 PDF。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an unencrypted PDF that allows copying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請改選未加密、允許複製的 PDF。"
          }
        }
      }
    },
    "issue.interactivePDF": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能丢失签名或表单，仍要合并？原文件会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signatures or form fields may be lost. Continue? Originals are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能遺失簽名或表單，仍要合併？原檔案會保留。"
          }
        }
      }
    },
    "issue.writeFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存副本，现有文件保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the copy. Existing files were kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存副本，現有檔案保持不變。"
          }
        }
      }
    },
