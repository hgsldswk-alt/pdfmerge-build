    "issue.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件。请下载到本机或重选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read this file. Download it locally or choose again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取檔案。請下載到本機或重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。端末にダウンロードするか、選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 읽지 못했습니다. 기기에 내려받거나 다시 고르세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht gelesen werden. Lade sie lokal oder wähle sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer este archivo. Descárgalo al dispositivo o elígelo de nuevo."
          }
        }
      }
    },
    "issue.invalidPDF": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 已损坏、没有页面或无法读取。"
